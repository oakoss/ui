{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalDependencies": [".gitignore", "registry.json"],
  "tasks": {
    "build": { "dependsOn": ["^typecheck"], "outputs": ["dist/**"] },
    "build-storybook": {
      "dependsOn": ["^typecheck"],
      "outputs": ["storybook-static/**"]
    },
    "test": { "dependsOn": ["^typecheck"] },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
