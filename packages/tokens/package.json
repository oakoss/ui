    "@oakoss/oxlint-config": "workspace:*",
    "@oakoss/tsconfig": "workspace:*",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "culori": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
