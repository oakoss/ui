{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": { "env": ["REGISTRY_URL"] },
    "build-registry": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["REGISTRY_URL", "REQUIRE_RELEASE_TAG"]
    },
    "test": {
      "dependsOn": ["build", "build-registry"],
      "env": ["$TURBO_EXTENDS$", "REGISTRY_URL"]
    }
  }
}
