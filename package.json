{
  "name": "oakoss-ui",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/oakoss/ui#readme",
  "bugs": "https://github.com/oakoss/ui/issues",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakoss/ui.git"
  },
  "type": "module",
  "scripts": {
    "build-storybook": "turbo run build-storybook",
    "changeset": "changeset",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint && pnpm run lint:md",
    "lint:eslint": "eslint --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "lint:eslint:fix": "eslint --max-warnings 0 --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix && pnpm run lint:md:fix",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "release:tag": "changeset git-tag",
    "release:version": "changeset version",
    "storybook": "pnpm --filter @oakoss/storybook storybook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.23.1",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "^1.6.27",
    "czg": "^1.14.0",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "^1.86.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "lefthook": "^2.1.15",
    "markdownlint-cli2": "^0.23.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "shadcn": "^4.21.0",
    "tailwindcss": "catalog:",
    "turbo": "^2.11.5",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.10.0",
      "onFail": "error"
    }
  }
}
